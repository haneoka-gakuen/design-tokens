{
  "name": "@haneoka/design-tokens",
  "version": "0.1.0",
  "description": "Framework-neutral primitive, semantic, density, motion, and elevation tokens",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/design-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/design-tokens/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/design-tokens#readme",
  "type": "module",
  "sideEffects": [
    "./src/tokens.css",
    "./src/schemes.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens.css",
    "src/schemes.css",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./schemes.css": "./src/schemes.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "generate": "node scripts/generate-schemes.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@material/material-color-utilities": "0.3.0",
    "prettier": "3.9.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "keywords": [
    "material-design",
    "design-tokens",
    "css",
    "haneoka"
  ]
}
